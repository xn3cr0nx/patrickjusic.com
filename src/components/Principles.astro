---
/**
 * Principles — a numbered "how I work" block. A tasteful nod to Chipcolate's
 * "Our Principles": each entry has a green mono index, a glow subhead, and body
 * copy, revealing on scroll with a small stagger.
 *
 * Reads from src/data/about.ts by default; pass `items` to override.
 */
import GlowHeading from './GlowHeading.astro';
import { principles as defaultPrinciples, type Principle } from '../data/about';

interface Props {
  items?: Principle[];
}

const { items = defaultPrinciples } = Astro.props;
---

<ol class="mt-10 border-t border-line">
  {
    items.map((p, i) => (
      <li
        data-reveal
        style={`--reveal-delay:${(i * 0.08).toFixed(2)}s`}
        class="grid grid-cols-[2.5rem_1fr] md:grid-cols-[4rem_1fr] gap-x-5 md:gap-x-10 border-b border-line py-8 md:py-10"
      >
        <span
          class="mono text-green-bright text-xl md:text-3xl leading-none pt-1 tabular-nums select-none"
          aria-hidden="true"
        >
          {String(i + 1).padStart(2, '0')}
        </span>
        <div>
          <GlowHeading level={3} class="text-xl md:text-2xl tracking-tight">
            {p.title}
          </GlowHeading>
          <p class="mt-3 max-w-2xl text-[15px] md:text-base leading-relaxed text-muted">
            {p.body}
          </p>
        </div>
      </li>
    ))
  }
</ol>
