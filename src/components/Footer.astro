---
/**
 * Footer — shared site footer.
 * Wordmark, nav echo, social links (X / GitHub / LinkedIn), a "Get in touch"
 * link, and a copyright line. No email address (routes to /contact instead).
 */
const year = new Date().getFullYear();

const navLinks = [
  { label: 'Work', href: '/work' },
  { label: 'Writing', href: '/writing' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const socials = [
  { label: 'X', href: 'https://x.com/xn3cr0nx' },
  { label: 'GitHub', href: 'https://github.com/xn3cr0nx' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/patrickjusic/' },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" class="wordmark" aria-label="Patrick Jusic — home">
          <span class="wordmark__first">patrick</span>&nbsp;<span
            class="wordmark__last">jusic</span
          >
        </a>
        <p class="site-footer__signature mono">— xn3cr0nx</p>
      </div>

      <nav class="site-footer__nav" aria-label="Footer">
        <ul>
          {navLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>

      <div class="site-footer__connect">
        <ul class="site-footer__socials">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a href="/contact" class="site-footer__cta">Get in touch →</a>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} Patrick Jusic. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--bg);
    margin-top: 6rem;
  }
  .site-footer__inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3.5rem 1.25rem 2.5rem;
  }
  .site-footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 720px) {
    .site-footer__top {
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 2rem;
    }
  }

  .wordmark {
    font-size: 1.05rem;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .wordmark__first {
    color: var(--text);
    font-weight: 700;
  }
  .wordmark__last {
    color: var(--muted);
    font-weight: 400;
  }
  .site-footer__signature {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .site-footer__nav ul,
  .site-footer__socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .site-footer__connect {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  .site-footer__nav a,
  .site-footer__socials a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }
  .site-footer__nav a:hover,
  .site-footer__socials a:hover {
    color: var(--text);
  }

  .site-footer__cta {
    color: var(--green);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .site-footer__cta:hover {
    color: var(--green-bright);
  }

  .site-footer__bottom {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .site-footer__bottom p {
    color: var(--muted);
    font-size: 0.8rem;
    margin: 0;
  }
</style>
