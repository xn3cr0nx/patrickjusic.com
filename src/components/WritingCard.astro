---
/**
 * WritingCard — a single entry in the /writing index list.
 *
 * Renders a bordered card linking to the post. Shows the title (glows on
 * hover), a mono meta row (date · reading time · optional "mirrored" tag),
 * and the excerpt.
 *
 * Props:
 *   href        — post URL (e.g. "/writing/the-api-versioning-trap")
 *   title       — post title
 *   date        — post date (Date)
 *   readingTime — estimated reading time in minutes (number)
 *   excerpt     — short description / excerpt
 *   mirrored    — whether this is a mirrored/cross-posted piece (default false)
 *   class       — extra classes merged onto the <article>
 */
import Badge from './Badge.astro';

interface Props {
  href: string;
  title: string;
  date: Date;
  readingTime: number;
  excerpt: string;
  mirrored?: boolean;
  class?: string;
}

const {
  href,
  title,
  date,
  readingTime,
  excerpt,
  mirrored = false,
  class: className = '',
} = Astro.props;

const displayDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const isoDate = date.toISOString();
---

<a href={href} class="group block">
  <article
    class:list={[
      'writing-card relative rounded-[var(--radius)] border border-[var(--line)] bg-[var(--bg-2)] p-6 md:p-7 transition-colors duration-200 group-hover:border-green/40',
      className,
    ]}
  >
    <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[12.5px] text-[var(--muted)]">
      <time datetime={isoDate}>{displayDate}</time>
      <span aria-hidden="true" class="text-[var(--line)]">/</span>
      <span>{readingTime} min read</span>
      {mirrored && <Badge variant="neutral" class="ml-1">mirrored</Badge>}
    </div>

    <h3 class="text-xl md:text-2xl font-bold leading-snug text-[var(--text)] transition-colors duration-200 group-hover:text-green-bright">
      {title}
    </h3>

    <p class="mt-3 leading-relaxed text-[var(--muted)]">{excerpt}</p>

    <span
      class="mt-4 inline-flex items-center gap-1.5 font-mono text-[12.5px] text-green transition-transform duration-200 group-hover:translate-x-0.5"
      aria-hidden="true"
    >
      Read <span>&rarr;</span>
    </span>
  </article>
</a>
