---
import Layout from '../layouts/Layout.astro';
import Kicker from '../components/Kicker.astro';
import GlowHeading from '../components/GlowHeading.astro';
import { MessageForm } from '../components/message-form';

const socials = [
  {
    label: 'X',
    handle: '@xn3cr0nx',
    href: 'https://x.com/xn3cr0nx',
    path: 'M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z',
  },
  {
    label: 'GitHub',
    handle: 'xn3cr0nx',
    href: 'https://github.com/xn3cr0nx',
    path: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  },
  {
    label: 'LinkedIn',
    handle: 'patrickjusic',
    href: 'https://www.linkedin.com/in/patrickjusic/',
    path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
];
---

<Layout
  active="contact"
  title="Contact"
  description="Get in touch with Patrick Jusic — advisory and angel investing, or serious builds through Chipcolate."
>
  <main class="mx-auto w-full max-w-5xl px-6 pt-28 pb-24 md:pt-32">
    <header class="max-w-2xl" data-reveal>
      <Kicker>// contact</Kicker>
      <GlowHeading level={1} class="mt-4 text-5xl tracking-tight md:text-6xl">
        Let&rsquo;s talk.
      </GlowHeading>
      <p class="mt-6 text-lg leading-relaxed text-muted">
        Whether you&rsquo;re weighing an architecture call, scaling a team, or
        shipping something ambitious — drop a line below and I&rsquo;ll reply
        within 24 hours.
      </p>
    </header>

    <div class="mt-14 grid gap-12 md:mt-16 md:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] md:gap-16">
      <!-- Form -->
      <section
        class="rounded-[var(--radius)] border border-[var(--line)] bg-[var(--bg-2)] p-6 sm:p-8"
        data-reveal
        style="--reveal-delay:.06s"
        aria-label="Send a message"
      >
        <MessageForm client:load />
      </section>

      <!-- Aside: how I work + direct links -->
      <aside class="flex flex-col gap-10" data-reveal style="--reveal-delay:.12s">
        <div>
          <h2 class="mono text-sm font-medium uppercase tracking-[0.16em] text-green">
            How I work
          </h2>
          <ul class="mt-4 space-y-4 text-[15px] leading-relaxed text-muted">
            <li>
              <span class="font-medium text-text">Advisory &amp; angel.</span>
              Fractional guidance on architecture, scaling and team-building for
              early-stage founders.
            </li>
            <li>
              <span class="font-medium text-text">Serious builds.</span>
              For hands-on product and engineering work, I take these on through
              <a
                href="https://chipcolate.com"
                target="_blank"
                rel="noopener noreferrer"
                class="text-green-bright underline-offset-4 transition-colors hover:text-green"
                >Chipcolate</a
              >.
            </li>
          </ul>
        </div>

        <div>
          <h2 class="mono text-sm font-medium uppercase tracking-[0.16em] text-green">
            Elsewhere
          </h2>
          <ul class="mt-4 space-y-1">
            {
              socials.map((s) => (
                <li>
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group -mx-2 flex items-center gap-3 rounded-md px-2 py-2 transition-colors hover:bg-[rgba(255,255,255,.03)]"
                  >
                    <svg
                      role="img"
                      viewBox="0 0 24 24"
                      class="h-5 w-5 shrink-0 fill-current text-muted transition-colors group-hover:text-green"
                      xmlns="http://www.w3.org/2000/svg"
                      aria-hidden="true"
                    >
                      <path d={s.path} />
                    </svg>
                    <span class="text-[15px] font-medium text-text">{s.label}</span>
                    <span class="mono text-sm text-muted">{s.handle}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </main>

  <script>
    import { initReveal } from '../lib/reveal';
    initReveal();
  </script>
</Layout>
