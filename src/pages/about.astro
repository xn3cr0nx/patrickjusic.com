---
import Layout from '../layouts/Layout.astro';
import Kicker from '../components/Kicker.astro';
import GlowHeading from '../components/GlowHeading.astro';
import Badge from '../components/Badge.astro';
import Principles from '../components/Principles.astro';
import { bio, facts, workTracks } from '../data/about';
---

<Layout
  active="about"
  title="About"
  description="Founder and engineering leader — a decade building and scaling systems, and the teams behind them. Now Co-Founder & CTO at Chipcolate."
>
  <main class="mx-auto w-full max-w-6xl px-5 md:px-8">
    <!-- ── Intro ─────────────────────────────────────────── -->
    <section class="relative pt-28 md:pt-36 pb-16 md:pb-24">
      <div class="scanline" aria-hidden="true"></div>

      <div class="grid items-start gap-10 md:grid-cols-[1.5fr_1fr] md:gap-16">
        <div data-reveal>
          <Kicker>// about</Kicker>
          <GlowHeading level={1} class="mt-5 text-4xl md:text-6xl tracking-tight text-balance">
            A decade building — and scaling — what matters.
          </GlowHeading>

          <div class="mt-8 space-y-5 max-w-2xl text-[15px] md:text-lg leading-relaxed text-muted">
            {bio.map((para) => <p>{para}</p>)}
          </div>

          <div class="mt-8 flex flex-wrap gap-2.5">
            {facts.map((f) => <Badge variant={f.variant ?? 'green'}>{f.label}</Badge>)}
          </div>
        </div>

        <!-- Portrait -->
        <div data-reveal style="--reveal-delay:.12s" class="md:pt-2">
          <figure
            class="relative overflow-hidden rounded-lg border border-line bg-bg-2"
          >
            <img
              src="/about-portrait.webp"
              alt="Portrait of Patrick Jusic"
              width="640"
              height="640"
              loading="lazy"
              decoding="async"
              class="h-auto w-full object-cover opacity-90"
            />
            <div class="scanline" aria-hidden="true"></div>
            <figcaption
              class="mono absolute bottom-3 left-4 text-[11px] tracking-wide text-muted"
            >
              — xn3cr0nx
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ── Principles ────────────────────────────────────── -->
    <section class="border-t border-line py-16 md:py-24">
      <div data-reveal>
        <Kicker>// how I work</Kicker>
        <GlowHeading level={2} class="mt-5 text-3xl md:text-5xl tracking-tight">
          How I work
        </GlowHeading>
        <p class="mt-5 max-w-2xl text-[15px] md:text-lg leading-relaxed text-muted">
          A few principles I keep coming back to — in the code, in the
          architecture, and in the teams.
        </p>
      </div>

      <Principles />
    </section>

    <!-- ── Work with me ──────────────────────────────────── -->
    <section class="relative border-t border-line py-16 md:py-24">
      <div class="beam" aria-hidden="true"></div>

      <div data-reveal>
        <Kicker>// work with me</Kicker>
        <GlowHeading level={2} class="mt-5 text-3xl md:text-5xl tracking-tight">
          Let's build something.
        </GlowHeading>
        <p class="mt-5 max-w-2xl text-[15px] md:text-lg leading-relaxed text-muted">
          There are a couple of ways we tend to work together.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {
          workTracks.map((track, i) => (
            <article
              data-reveal
              style={`--reveal-delay:${(0.08 + i * 0.08).toFixed(2)}s`}
              class="flex flex-col rounded-lg border border-line bg-bg-2 p-6 md:p-8"
            >
              <Kicker>// {track.kicker}</Kicker>
              <h3 class="mt-3 text-xl md:text-2xl font-bold tracking-tight text-text">
                {track.title}
              </h3>
              <p class="mt-3 flex-1 text-[15px] leading-relaxed text-muted">
                {track.body}
              </p>
              <a
                href={track.cta.href}
                {...(track.cta.external
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
                class="group mt-6 inline-flex items-center gap-1.5 self-start text-[15px] font-medium text-green-bright transition-colors hover:text-green"
              >
                {track.cta.label}
                <span
                  class="transition-transform group-hover:translate-x-0.5"
                  aria-hidden="true"
                >
                  →
                </span>
              </a>
            </article>
          ))
        }
      </div>

      <!-- Open CTA -->
      <div
        data-reveal
        style="--reveal-delay:.24s"
        class="mt-10 flex flex-col items-start gap-4 rounded-lg border border-line bg-bg-2 p-6 md:flex-row md:items-center md:justify-between md:p-8"
      >
        <p class="text-[15px] md:text-lg text-text">
          Not sure which one? <span class="text-muted">Reach out anyway — I'm happy to point you the right way.</span>
        </p>
        <a
          href="/contact"
          class="inline-flex shrink-0 items-center gap-2 rounded-lg bg-green px-5 py-3 text-[15px] font-medium text-bg transition-colors hover:bg-green-bright"
        >
          Get in touch
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>

  <script>
    import { initReveal } from '../lib/reveal';
    initReveal();
  </script>
</Layout>
